# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
# Exclude all build outputs. Vercel now builds fresh in CI (see
# .github/workflows/flutter.yml's deploy-vercel job) rather than serving a
# pre-built build/web committed to git.
build/
*.iml

# Android
android/.gradle/
android/.kotlin/
android/captures/
android/local.properties
android/key.properties
android/app/*.jks

# iOS/macOS
ios/.symlinks/
ios/Pods/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
mac/.symlinks/
macos/Pods/

# Web
web/flutter_service_worker.js

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

.vercel
.env*

# Supabase CLI local cache (project link state, not project source)
supabase/.temp/
